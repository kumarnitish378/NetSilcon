---
import { useCaseUrl } from '../config';
import Base from '../layouts/Base.astro';
import SecHead from '../components/SecHead.astro';
import Icon from '../components/Icon.astro';
import { applications } from '../data/facts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
---
<Base title="Applications" crumbs={[{ name: 'Applications', path: '/applications/' }]} description="Uses for a small neural network on FPGA: motor and ESC faults, irrigation, robot obstacle decisions, BMS cell anomalies, pump cavitation and fan health.">
  <div class="wrap">
    <header class="pagehd">
      <div>
        <span class="crumb">Applications</span>
        <h1>Four readings in, one decision out.</h1>
        <p class="lede">If a job can be written as four numbers and a yes/no or a value, it fits NetSilcon-6x4. The microcontroller measures and scales the inputs; the chip decides in microseconds.</p>
      </div>
      <div class="panel legend">
        <p class="callout" style="margin:0 0 8px">How to read the cards</p>
        <p class="small" style="margin:0 0 6px"><span class="pill ok">Model file</span> trained, packed and verified bit-exact on the FPGA reference.</p>
        <p class="small" style="margin:0"><span class="pill">Example</span> an input set from the datasheet. You would train it on your own logged data.</p>
      </div>
    </header>

    <section class="sec" aria-label="Applications">
      <div class="apps">
        {applications.map((a) => (
          <article class="app" id={a.id}>
            <header><Icon name={a.icon} /><span class={a.model ? 'pill ok' : 'pill'}>{a.model ? 'Model file' : 'Example'}</span></header>
            <h2>{a.title}</h2>
            <div class="io">
              <div>
                <p class="callout">Inputs x0 … x3</p>
                <ol class="ins">{a.inputs.map((i) => <li>{i}</li>)}</ol>
              </div>
              <div>
                <p class="callout">Decides</p>
                <p class="dec">{a.decides}</p>
              </div>
            </div>
            <p class="small foot">{a.status}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sec" aria-labelledby="fit">
      <SecHead no="Fit check" title="Is your job a good fit?" id="fit" />
      <div class="cols cols-3">
        <div><h3>Good fit</h3><p class="mut">A few sensor readings, a fast and repeatable answer, power or cost too tight for a bigger processor. Fault checks beside a motor drive, a pump or a battery.</p></div>
        <div><h3>Needs care</h3><p class="mut">Jobs that need memory of the past. The network sees only the current four inputs, so feed it features like a rate of change, or add a small supervisor, as the rover does.</p></div>
        <div><h3>Not a fit</h3><p class="mut">Images, audio streams or language. NetSilcon-6x4 has 170 parameters on purpose. <a href={u('/netsilcon-64x6/')}>NetSilcon-64x6</a> takes 16 inputs and about 23,000 parameters, still meant for sensor-level decisions.</p></div>
      </div>
      <p class="more"><a href={u('/docs/train-your-own-model/')}>Train a model for your own job →</a></p>
      {useCaseUrl && <div class="usecase"><h3>Suggest a use case</h3><p>Do you have a sensor decision you would like a NetSilcon engine to learn? Send the inputs (up to 4 for NetSilcon-6x4, up to 16 for NetSilcon-64x6) and the decision you need. Good ideas become the next trained model, published with its test results.</p><a class="btn pri" href={useCaseUrl} rel="noopener">Message Nitish on LinkedIn</a></div>}
    </section>
  </div>
</Base>
<style>
  .usecase { margin-top: 28px; padding: 18px 20px; border-left: 3px solid var(--acc); background: var(--acc-bg); max-width: 860px; }
  .usecase h3 { margin-top: 0; }
  .legend { padding: 18px 20px; }
  .pill { display: inline-block; font: 500 11px/1 var(--mono); padding: 5px 7px 4px; border: 1px solid var(--mut); color: var(--mut); margin-right: 6px; white-space: nowrap; }
  .pill.ok { border-color: var(--acc); color: var(--acc); background: var(--acc-bg); }
  .apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--rule); }
  .app { background: var(--surface); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: clamp(18px, 2.4vw, 28px); display: flex; flex-direction: column; scroll-margin-top: 90px; }
  .app:target { box-shadow: inset 0 0 0 2px var(--acc); }
  .app header { display: flex; justify-content: space-between; align-items: start; }
  .app h2 { font-size: clamp(20px, 2vw, 24px); margin: 4px 0 16px; }
  .io { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 20px; border-top: 1px solid var(--rule-2); padding-top: 14px; }
  .io .callout { margin: 0 0 6px; }
  .ins { margin: 0; padding-left: 0; list-style: none; counter-reset: x; font-size: 15px; }
  .ins li { counter-increment: x; padding: 3px 0; display: grid; grid-template-columns: 2.2em minmax(0, 1fr); }
  .ins li::before { content: 'x' counter(x, decimal); font: 12px/1.9 var(--mono); color: var(--acc); }
  .ins li:nth-child(1)::before { content: 'x0'; } .ins li:nth-child(2)::before { content: 'x1'; } .ins li:nth-child(3)::before { content: 'x2'; } .ins li:nth-child(4)::before { content: 'x3'; }
  .dec { font-size: 16px; margin: 0; }
  .foot { margin: auto 0 0; padding-top: 16px; font-family: var(--mono); font-size: 12px; }
  .cols .mut { font-size: 16px; margin: 8px 0 0; }
  .more { margin: 18px 0 0; } .more a { color: var(--acc); font-weight: 600; text-decoration: none; }
  @media (max-width: 860px) { .apps { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .io { grid-template-columns: minmax(0, 1fr); } }
</style>
