---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Page not found">
  <div class="wrap">
    <header class="pagehd"><div><span class="crumb">Error 404</span><h1>That page isn't here.</h1><p class="lede">The address may be old or mistyped.</p>
      <div class="btns" style="margin-top:24px"><a class="btn pri" href={`${base}/`}>Home</a><a class="btn" href={`${base}/docs/`}>Docs</a></div></div></header>
  </div>
</Base>
